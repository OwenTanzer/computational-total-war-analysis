            "inputs": {
              "leadership_rank": 0.55,
              "immune_to_psychology_flag": 0.2,
              "unbreakable_flag": 0.25
            }
          },
          "redundancy": {
            "weight": 0.35,
            "inputs": {
              "expendable_flag": 0.45,
              "inverse_cost_rank": 0.3,
              "entity_count_rank": 0.25
            }
          }
        }
