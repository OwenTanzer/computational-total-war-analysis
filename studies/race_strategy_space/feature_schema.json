{
  "schema_version": 3,
  "normalization": {
    "positive_values": "percentile rank among positive observations",
    "structural_zero": "retained as exactly zero"
  },
  "unit_population": {
    "include_roster_scope": [
      "race_core",
      "race_core_and_variant"
    ],
    "exclude_categories": [
      "character"
    ],
    "exclude_regiments_of_renown": true,
    "require_positive_multiplayer_cost": true
  },
  "views": {
    "breadth": {
      "description": "How widely a race can express the capability.",
      "weights": {
        "high_role_cost_cell_coverage": 0.4,
        "positive_unit_share": 0.3,
        "high_unit_share": 0.3
      },
      "high_threshold": "global 65th percentile among positive unit scores"
    },
    "ceiling": {
      "description": "Strength of the race's best options.",
      "aggregation": "mean of top 8 percent of eligible units, minimum 1 and maximum 3 units"
    },
    "cost_access": {
      "description": "How cheaply the capability appears on the multiplayer-cost frontier; this is not campaign recruitment access.",
      "aggregation": "mean best score below 12 global cost caps from the 10th to 95th percentiles"
    }
  },
  "comparison_weights": {
    "block_total": "equal across four blocks after column standardization",
    "primary_feature": {
      "breadth": 0.5,
      "ceiling": 0.25,
      "cost_access": 0.25
    },
    "squared_weight_formula": "view_share / (3 * feature_count_in_block); equal block totals of 1/3 preserve prior distance scale"
  },
  "sensitivities": {
    "unit_tier": {
      "column_suffix": "unit_tier_sensitivity",
      "description": "Mean best score available at or below main_units.tier values 1 through 5.",
      "scope": "15 unit-derived features only",
      "interpretation": "Unit-quality classification sensitivity; not a campaign recruitment-unlock or commander-access measure.",
      "weights": {
        "breadth": 0.5,
        "ceiling": 0.25,
        "cost_access": 0.125,
        "unit_tier_sensitivity": 0.125
      },
      "excluded_from_primary": true,
      "known_missing_for_campaign_access": "exact building, technology, resource, landmark, scripted-pool, and starting-state gates"
    }
  },
  "blocks": {
    "geometry": {
      "movement": {
        "inputs": {
          "speed_rank": 0.75,
          "terrain_mobility_flag": 0.15,
          "fire_while_moving_flag": 0.1
        }
      },
      "deployment": {
        "inputs": {
          "vanguard_flag": 0.3,
          "stalk_or_snipe_flag": 0.25,
          "flying_flag": 0.3,
          "terrain_mobility_flag": 0.15
        }
      },
      "shock": {
        "inputs": {
          "speed_rank": 0.3,
          "charge_bonus_rank": 0.3,
          "mass_rank": 0.25,
          "devastating_flanker_flag": 0.15
        }
      },
      "contact_authority": {
        "inputs": {
          "mass_rank": 0.4,
          "anti_target_peak_rank": 0.2,
          "charge_defence_flag": 0.2,
          "large_flag": 0.1,
          "single_entity_flag": 0.1
        }
      }
    },
    "damage": {
      "melee_pressure": {
        "inputs": {
          "melee_attack_rank": 0.3,
          "melee_damage_rate_rank": 0.35,
          "weapon_ap_damage_rank": 0.2,
          "anti_target_peak_rank": 0.15
        }
      },
      "missile_pressure": {
        "inputs": {
          "missile_launch_power_rank": 0.5,
          "range_rank": 0.2,
          "delivery_quality": 0.15,
          "ammunition_rank": 0.15
