        "inputs": {
          "barrier_health_rank": 0.5,
          "regeneration_flag": 0.35,
          "summon_flag": 0.15
        }
      }
    },
    "architecture": {
      "role_coverage": {
        "breadth": "share of six roles present",
        "ceiling": "normalized entropy across six role counts",
        "cost_access": "share of 24 role-by-cost cells present"
      },
      "elite_orientation": {
        "breadth": "share above global 75th multiplayer-cost percentile",
        "ceiling": "share of feature champions above global 75th cost percentile",
        "cost_access": "Spearman correlation between mean unit feature score and cost"
      },
      "battlefield_control": {
        "inputs": {
          "contact_control_flag": 0.18,
          "armour_control_flag": 0.12,
          "morale_contact_flag": 0.12,
          "snare_flag": 0.12,
          "formation_flag": 0.12,
          "charge_defence_flag": 0.12,
          "fear_flag": 0.1,
          "terror_flag": 0.12
        }
      },
      "command_magic": {
        "breadth": "generic caster lore count capped at 8",
        "ceiling": "coverage of healing, summoning, control, protection, and damage categories",
        "cost_access": "generic caster count capped at 4"
      }
    }
  },
  "archetypes": {
    "method": "convex archetypal analysis: X approximated by W H X; both W and H have nonnegative simplex rows",
    "candidate_resolutions": [
      3,
      4,
      5,
      6,
      7,
      8
    ],
    "seed": 811,
    "perturbations": 40,
    "perturbation_definition": "54 columns resampled with replacement (multinomial counts); multiply by sqrt(count) and independent Normal(1, 0.08) noise",
    "alignment": "Hungarian assignment of hull-defined poles in the original weighted feature space",
    "stability_rule": {
      "global_membership_rmse_max": 0.12,
      "race_membership_rmse_max": 0.25
    },
    "selection": "smallest stable resolution at or after maximum normalized error-curve chord deviation",
    "no_stable_resolution": "selected_resolution=null; report error-knee memberships explicitly as provisional diagnostics",
    "local_neighbors": 4
  }
}
